# =============================================================================
# Royce Environment Variables
# Copy to .env and fill in real values. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (shared)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # BACKEND ONLY — never expose to browser

# Public frontend vars (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Backend infrastructure
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Fernet key used to encrypt user-provided AI provider API keys at rest.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret. Rotating it invalidates all stored credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Optional global routing defaults (per-user priority still wins when set)
# AI_DEFAULT_PROVIDER=gemini
# AI_FALLBACK_PROVIDERS=groq,cerebras

# -----------------------------------------------------------------------------
# Tools (optional infrastructure keys, not user provider keys)
# -----------------------------------------------------------------------------
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=tavily   # tavily | serper | none

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
REQUEST_TIMEOUT_SECONDS=60
